{
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.17.0",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10.2.2",
    "@sap/xssec": "^4"
  },
  "cds": {
    "requires": {
      "API_SALES_ORDER_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_SALES_ORDER_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4_SANDBOX",
            "path": "/s4hanacloud/sap/opu/odata/sap/API_SALES_ORDER_SRV"
          }
        }
      },
      "API_OUTBOUND_DELIVERY_SRV_0002": {
        "kind": "odata-v2",
        "model": "srv/external/API_OUTBOUND_DELIVERY_SRV_0002",
        "[production]": {
          "credentials": {
            "destination": "S4_SANDBOX",
            "path": "/s4hanacloud/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=0002"
          }
        }
      },
      "LIEFERSTATUS_IFLOW": {
        "kind": "rest",
        "[production]": {
          "credentials": {
            "destination": "LIEFERSTATUS_IFLOW"
          }
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "anna": {
            "password": "123",
            "roles": [
              "Dispatcher"
            ]
          },
          "ben": {
            "password": "123",
            "roles": [
              "Viewer"
            ]
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      },
      "destinations": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "start": "cds-serve",
    "watch-trackingapp": "cds watch --open trackingapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapux": [
    "app/trackingapp"
  ]
}
