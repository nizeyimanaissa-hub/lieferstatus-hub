{
  "_version": "1.89.0",
  "sap.app": {
    "id": "trackingapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "a3e4d809-ce04-4171-ae53-69dbb8e8f68c"
    },
    "dataSources": {
      "mainService": {
        "uri": "/tracking/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.fe.core": {},
        "sap.fe.macros": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "trackingapp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/dashboard.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "OrderTrackingList",
          "target": "OrderTrackingList"
        },
        {
          "pattern": "OrderTracking({key}):?query:",
          "name": "OrderTrackingObjectPage",
          "target": "OrderTrackingObjectPage"
        }
      ],
      "targets": {
        "OrderTrackingList": {
          "type": "Component",
          "id": "OrderTrackingList",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "trackingapp.ext.dashboard.Dashboard",
              "contextPath": "/OrderTracking",
              "navigation": {
                "OrderTracking": {
                  "detail": {
                    "route": "OrderTrackingObjectPage"
                  }
                }
              }
            }
          }
        },
        "OrderTrackingObjectPage": {
          "type": "Component",
          "id": "OrderTrackingObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/OrderTracking"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}